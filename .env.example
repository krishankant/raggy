# Copy to .env. Everything is optional: with no changes raggy runs fully local
# (fastembed embeddings + Ollama for answers).

# Which model writes the answers: ollama | anthropic | openai
RAGGY_LLM=ollama
# Model name for that provider (defaults: ollama=qwen3.5:4b, anthropic=claude-opus-5-5)
# RAGGY_LLM_MODEL=

# Hosted providers (only needed if RAGGY_LLM points at them)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_MODEL=

# Where the index lives (default: .raggy in the current directory)
# RAGGY_INDEX_DIR=.raggy
# RAGGY_EMBED_MODEL=BAAI/bge-small-en-v1.5
# RAGGY_TOP_K=4

# The model that grades answers in `raggy eval` (default: anthropic if
# ANTHROPIC_API_KEY is set, otherwise ollama). Pick a strong model: a weak
# judge gives noisy scores.
# RAGGY_JUDGE=anthropic
# RAGGY_JUDGE_MODEL=claude-opus-5-5

# Ingestion (week 3)
# RAGGY_HTML_EXTRACT=main     # main: article text only (default); full: every visible word
# RAGGY_DEDUPE=1              # 0 to index duplicate documents too

# Chunking (week 4)
# RAGGY_CHUNKER=structure          # structure (default) | recursive | fixed (characters, weeks 1-3)
# RAGGY_CHUNK_TOKENS=256           # recursive/structure chunk size, in model tokens
# RAGGY_CHUNK_OVERLAP_TOKENS=32
# RAGGY_CHUNK_HEADERS=1            # embed "title › section" with each chunk
# RAGGY_PARENT_TOKENS=512          # 0 = off; search small chunks, answer with their parent
# RAGGY_CHUNK_CONTEXT=none         # llm: contextual retrieval (one paid LLM call per chunk, cached)

# Scale (week 5)
# RAGGY_STORE=lance              # lance (on disk, filters) | numpy (week 1's in-memory matrix)
# RAGGY_EMBED_CACHE=1            # 0 re-embeds everything every time
# RAGGY_ANN=off                  # on: approximate index (IVF-HNSW-SQ); worth it well past 100k chunks
# RAGGY_ANN_NPROBES=20
# RAGGY_ANN_REFINE=4

# Hybrid search (week 6)
# RAGGY_RETRIEVAL=vector         # vector | keyword (BM25) | hybrid (both, fused with RRF)
# RAGGY_RRF_K=60
# RAGGY_FUSION_CANDIDATES=50

# Reranking and query transforms (week 7) — both off by default: see the week 7 lesson
# RAGGY_RERANK=none              # none | local (cross-encoder, ~0.4 s/question) | llm (listwise, a paid call)
# RAGGY_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # BAAI/bge-reranker-base is the larger option (1 GB)
# RAGGY_RERANK_CANDIDATES=20
# RAGGY_QUERY_TRANSFORM=none     # none | rewrite | multi | hyde (one cached LLM call per question)
# RAGGY_BUDGETS=transform=2000,retrieve=100,rerank=500,generate=5000

# Grounded generation (week 8) — all off by default: see the week 8 lesson
# RAGGY_PACK=0                   # 1: merge overlapping passages, order them, fit RAGGY_CONTEXT_TOKENS
# RAGGY_CONTEXT_TOKENS=3000
# RAGGY_CITATION_CHECK=off       # off | lexical (free) | llm (one call per answer)
# RAGGY_CITATION_ACTION=report   # report | strip | refuse
# RAGGY_CITATION_THRESHOLD=0.5   # lexical: share of a sentence's content words found in its source
# RAGGY_REFUSAL_GATE=            # e.g. vector=0.63 — calibrate with evals/calibrate_gate.py

# Rich documents (week 9)
# RAGGY_PDF=layout               # layout (headings, ruled tables, page labels) | text (week 3's text layer)
# RAGGY_OCR=on                   # OCR pages with no text layer (scans): ~0.5 s a page

# Images (week 10) — off by default until measured: see the week 10 lesson
# RAGGY_IMAGES=off               # off | ocr (~0.5 s a picture) | vision (a model's description + OCR, cached)
# RAGGY_VISION=                  # ollama | openai | anthropic (default: RAGGY_LLM)
# RAGGY_VISION_MODEL=            # default: RAGGY_LLM_MODEL, or qwen3.5:4b for Ollama
# RAGGY_IMAGE_SEARCH=off         # on: CLIP vectors for `raggy images "query"` (needs RAGGY_IMAGES on)

# Audio and video (week 11) — off by default until measured: see the week 11 lesson
# RAGGY_MEDIA=off                # on: transcribe audio/video locally (subtitle files always load)
# RAGGY_WHISPER_MODEL=base       # tiny | base | small | medium | large-v3 (downloaded once)
# RAGGY_MEDIA_WINDOW=60          # seconds per transcript window; a speaker change starts a new one
# RAGGY_KEYFRAME_SECONDS=30      # video frames, read as pictures when RAGGY_IMAGES is on
# Media pages (YouTube, Vimeo, …) need yt-dlp: uv sync --extra media
